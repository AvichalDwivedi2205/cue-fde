FROM node:24-bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends git gh ca-certificates tar && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev && npm cache clean --force

COPY --chown=node:node tsconfig.json ./
COPY --chown=node:node lib ./lib
COPY --chown=node:node scripts ./scripts
COPY --chown=node:node demo ./demo
COPY --chown=node:node convex ./convex
COPY --chown=node:node deploy/start-worker.mjs ./deploy/start-worker.mjs
RUN mkdir -p /app/.cue && chown node:node /app/.cue

USER node
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 CUE_SHARED_CONFIG=true CUE_LOCAL_DEMO=false GIT_TERMINAL_PROMPT=0 GH_PROMPT_DISABLED=1
EXPOSE 8080
CMD ["node", "deploy/start-worker.mjs"]
